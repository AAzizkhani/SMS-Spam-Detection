# Python cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Build / packaging
build/
dist/
*.egg-info/

# Jupyter
.ipynb_checkpoints/

# IDE / Editor
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# NLTK / model / temp caches if created locally
*.tmp

# Generated data
data/processed/*
!data/processed/.gitkeep

# Generated outputs
outputs/figures/*
!outputs/figures/.gitkeep

outputs/embeddings/*
!outputs/embeddings/.gitkeep

outputs/models/*
!outputs/models/.gitkeep

